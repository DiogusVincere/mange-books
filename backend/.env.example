# Copie para .env e preencha. O .env não é versionado.

# String de conexão do MongoDB (Atlas ou local).
# Atlas:  mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/mangebook
# Local:  mongodb://localhost:27017/mangebook
# Deixe MONGO_URI vazio (ou apague a linha) para subir em modo demonstração:
# MongoDB embutido no processo + dados de exemplo (36 livros, avaliações, reservas,
# contas demo@demo.com e leitor@demo.com, senha demo1234).
MONGO_URI=

# Chave usada para assinar os tokens JWT. Use algo longo e aleatório, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em modo demonstração, se ficar vazia, uma chave temporária é gerada a cada subida.
JWT_SECRET=

# Porta do servidor
PORT=5000

# Origem (ou origens, separadas por vírgula) do front autorizadas pelo CORS.
# Pré-visualizações do front na Vercel (mange-books-*.vercel.app) já são aceitas.
CORS_ORIGIN=http://localhost:5173
